{
  "expo": {
    "name": "eDiscuss",
    "slug": "ediscuss",
    "scheme": [
      "com.deepaksharma955.echatapp",
      "ediscuss"
    ],
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/ediscusslogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.deepaksharma955.echatapp",
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/ediscusslogo.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "6f4e3a6d-cc76-436a-a455-e646e2bde22c"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/ediscusslogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for reading practice videos",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for reading practice",
          "recordAudioAndroid": true
        }
      ]
    ],
    "owner": "ediscuss0s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6f4e3a6d-cc76-436a-a455-e646e2bde22c"
    }
  }
}
